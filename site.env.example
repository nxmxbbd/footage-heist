# site.env --- one installation of footage-heist. Copy to ~/.config/footage-heist/site.env (or point
# IMPORT_SITE at it), mode 600, and replace every example value. KEY=VALUE lines, '#' comments on their own lines, no
# shell expansion; unknown keys are an error; an environment variable with the same name wins over this file.
# Reference: tool/siteconf.py. Every address, id and path below is an example (192.0.2.0/24 is a documentation range).

# ---- names this tool creates. Keep them stable once anything was imported: the ledger lives in the target's DB.
NAME_PREFIX=footage-heist
# default: NAME_PREFIX with '_'
#LEDGER_SCHEMA=footage_heist
# default: <NAME_PREFIX>-pg (the disposable PostgreSQL container on the controller)
#PG_CONTAINER=footage-heist-pg
# default: <NAME_PREFIX>-push (the transient copy unit on the source console)
#PUSH_UNIT=footage-heist-push
# how messages name the two consoles
SOURCE_NAME=source
TARGET_NAME=target

# ---- controller (the Linux machine that runs this repository)
# batch dirs, copy lists, queue state (mode 700)
IMPORT_DIR=/var/lib/footage-heist
# camera id map, README "Camera id map"
IDMAP=/var/lib/footage-heist/id-map.tsv
# AI processor id on the source / on the target: required by new-batch.sh (the validated setup has one on both
# consoles; consoles without an AI processor are not supported)
AI_SRC=0123456789abcdef01234567
AI_DST=89abcdef0123456789abcdef
# notification hook, README "Notifications" (empty: events are only logged)
NOTIFY_CMD=
# optional: journal tag whose lines carry "hdd_temp=<n>C" (shown by copyq-top)
#TOP_TEMP_JOURNAL_TAG=
# default: tool/unit-model.txt (README "Unit graph")
#UNIT_MODEL=

# ---- source console (the one the recordings come from); ssh destination or an ssh_config alias
SOURCE_SSH=root@192.0.2.10
# a root-only directory on the source that survives a reboot (ubv-push.py, its key, the copy ledger)
SOURCE_WORKDIR=/var/lib/footage-heist-push

# ---- target console (the one whose timeline receives them)
TARGET_SSH=root@192.0.2.20
# its web API (night.sh backup and camera states, verify-media.sh)
TARGET_URL=https://192.0.2.20
# curl --pinnedpubkey value (sha256//...) in a file
TARGET_TLS_PIN_FILE=/etc/footage-heist/target.pin
# curl -K file with the integration API key header: header = "X-API-KEY: <key>"
TARGET_API_HEADER_FILE=/etc/footage-heist/target-api.cfg
# JSON body for the console login: {"username": "...", "password": "..."} (a local admin)
TARGET_LOGIN_FILE=/etc/footage-heist/target-login.json
# staging dir on the target, on the SAME mount as Protect's video dir (hardlinks)
TARGET_STAGING=/volume/00000000-0000-0000-0000-000000000000/import-staging
# a root-only directory on the target that survives a reboot (batches, window logs)
TARGET_WORKDIR=/var/lib/footage-heist
#TARGET_PROTECT_DIR=/srv/unifi-protect
# the target as the SOURCE console reaches it (default: TARGET_SSH)
#PUSH_DEST=root@192.0.2.20

# ---- copy channel: ssh (default) or tcp (trusted LAN only, README "Copy channel")
COPY_MODE=ssh
COPY_RATE_MBPS=80
# bytes kept free on the target staging volume
COPY_MARGIN=1e12
